# OmniScale Enterprise Pro — Designed and Developed by NIKHIL CHARY SRIRAMOJU
# Copy to .env and fill in real values. Never commit a real .env file.

# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://omniscale:omniscale@localhost:5432/omniscale

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM providers: set ONE, or both (Groq is preferred if both are set) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_DIR=./data/vector_index

# --- CNN ---
CNN_WEIGHTS_DIR=./data/cnn_weights

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_ENTERPRISE=price_xxx
STRIPE_CONNECT_ENABLED=false
FRONTEND_SUCCESS_URL=http://localhost:3000/billing/success
FRONTEND_CANCEL_URL=http://localhost:3000/billing/cancel

# --- Observability ---
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# --- Rate limits (requests/min) ---
RATE_LIMIT_FREE_PER_MIN=20
RATE_LIMIT_PRO_PER_MIN=120
RATE_LIMIT_ENTERPRISE_PER_MIN=600
